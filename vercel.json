{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "error/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/(Style|Assets|css|images|js|favicon.ico)(.*)",
      "dest": "/$1$2"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/error/index.php"
    }
  ]
}